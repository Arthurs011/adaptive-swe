# --- LLM provider -----------------------------------------
# Use any OpenAI-compatible endpoint. Defaults to OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDINGS_MODEL=text-embedding-3-small

# --- Database ----------------------------------------------
# Suppabase/Postgres preferred; falls back to local SQLite for dev.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/adaptive_swe
# DATABASE_URL=sqlite:///./storage/adaptive_swe.db

# --- Sandbox ------------------------------------------------
# auto = use Docker if a usable engine exists, else local isolated venv
SANDBOX_MODE=auto
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true
DOCKER_IMAGE=python:3.11-slim

# --- Repair loop ---------------------------------------------
MAX_REPAIR_ATTEMPTS=5
MAX_REPO_SIZE_MB=200